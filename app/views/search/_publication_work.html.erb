<%= link_to publication_path(publication.id), class: "card" do %>
  <div class="card-inner">
    <div class="content">
      <div class="primary-info">
        <%= publication.title %>
      </div>
    </div>
    <div class="info">
      <div class="info-inner">
        <div class="indicators-left">
          <div class="indicator">
            <span class="badge badge-primary">Publication</span>
          </div>
        </div>
        <div class="indicators-right">
          <div class="indicator">
            <span>Published on: <b><%= nice_date_time(publication.createdOn) %></b></span>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
