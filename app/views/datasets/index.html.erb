<h1>Datasets</h1>

<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col">Name</th>
      <th scope="col">Namespace</th>
      <th scope="col">Datagraphs id</th>
      <th scope="col">Total concepts</th>
      <th scope="col">Concept types</th>
    </tr>
  </thead>
  <tbody>
    <% @datasets.each do |dataset| %>
      <tr>
        <th scope="row"><%= dataset.name %></th>
        <td><%= dataset.namespace %></td>
        <td><%= dataset.datagraphs_id %></td>
        <td><%= dataset.total_concepts %></td>
        <td>
          <% dataset.concept_types.each do |concept_type| %>
            <%= link_to concept_type.underscore.humanize, concepts_path(concept_type: concept_type) %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
