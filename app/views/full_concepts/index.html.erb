
<div class="block">
  <div class="tabs">
    <ul class="nav-tabs" role="tablist">
      <% @letters.each do |letter| %>
        <li role="presentation">
          <%= link_to letter, concepts_path(letter: letter), role: "tab", class: ("active" if letter == @letter) %>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<div class="mt-3 mb-3">
  <p>Count: <%= @total_count %></p>
  <% if @total_count > @pagy.limit %>
    <%== @pagy.series_nav(:bootstrap) %>
  <% end %>
</div>

<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col">Name</th>
      <th scope="col">Number of publications</th>
    </tr>
  </thead>
  <tbody>
    <% @concepts.each do |concept| %>
      <tr>
        <th scope="row"><%= concept.concept_name %><%#= link_to concept.concept_name, concept_path(concept.concept_id) %></th>
        <td><%#= concept.pw_count %>Coming soon!</td>
      </tr>
    <% end %>
  </tbody>
</table>
