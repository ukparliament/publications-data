<h2><%= @sub_title %></h2>

<% if @concepts.any? %>
  <div class="card-list card-list-3-col">
    <% @concepts.each do |concept| %>
      <%= link_to concepts_path(broader_term: concept.name), class: "card" do %>
        <div class="card-inner">
          <div class="content">
            <div class="primary-info"><%= concept.name %></div>
          </div>
          <div class="info">
            <div class="info-inner">
              <div class="indicators-left">
                <div class="indicator indicator-label">Publications: <%= concept.publication_count %></div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p>No child concepts</p>
<% end %>
