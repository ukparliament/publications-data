<div class="block">
  <div class="tabs">
    <ul class="nav-tabs" role="tablist">
      <li role="presentation">
        <%= link_to concepts_path, role: "tab", class: class_names(active: current_page?(concepts_path)) do %>
          All concepts
        <% end %>
      </li>
      <li role="presentation">
        <%= link_to promoted_concepts_path, role: "tab", class: class_names(active: current_page?(promoted_concepts_path)) do %>
          Promoted
        <% end %>
      </li>

    </ul>
    <div class="tab-content">
      <div class="tab-pane active" role="tabpanel">
        <div class="block">
          <div class="tabs">
            <ul class="nav-tabs" role="tablist">
              <% @letters.each do |letter| %>
                <li role="presentation">
                  <%= link_to letter, concepts_path(letter: letter), role: "tab", class: ("active" if letter == @letter) %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>

        <div class="mt-3 mb-3">
          <p>Count: <%= @total_count %></p>
          <% if @total_count > @pagy.limit %>
            <%== @pagy.series_nav(:bootstrap) %>
          <% end %>
        </div>

        <% if @concepts.any? %>
          <div class="card-list card-list-3-col">
            <% @concepts.each do |concept| %>
              <%= link_to concept_path(concept.id), class: "card" do %>
                <div class="card-inner">
                  <div class="content">
                    <div class="primary-info"><%= concept.concept_name %></div>
                  </div>
                  <div class="info">
                    <div class="info-inner">
                      <div class="indicators-left">
                        <div class="indicator indicator-label">Publication count: <%= concept.publications_count %></div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p>No child concepts</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
