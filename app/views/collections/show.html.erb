<% if @collection.lead_publication_work_id %>
  <p>Lead publication work: <%= link_to @collection.lead_publication_work_name, publication_path(@collection.lead_publication_work_id) %></p>
<% end %>

<% if @publication_works.any? %>
  <%= render 'publications/table', publications: @publication_works, pagy: @pagy, total_count: @total_count %>
<% else %>
  <h2>No publications</h2>
<% end %>
