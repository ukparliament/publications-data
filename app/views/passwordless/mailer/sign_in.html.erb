<body class="bg-light">
  <div class="container">
    <div class="card p-6 p-lg-10 space-y-4">
      <h1 class="h3 fw-700">Publications data explorer</h1>

      <p>Hi there,</p>
      <p>Use this token to complete your sign in: <span class="token"><%= @token %></span></p>
      <p>Alternatively you can use this link to <%= link_to "log in directly",
          @magic_link,
          target: :_blank
        %>.
      </p>
    </div>
    <div class="text-muted text-center my-6">
      Sent from Publications data explorer
    </div>
  </div>
</body>
