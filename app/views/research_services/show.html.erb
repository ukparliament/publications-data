<p>Short name: <b><%= @research_service.short_name %></b></p>

<p>For the: <b>
  <%= @research_service.houses.map do |house_id, house_name| %>
    <% link_to house_name, house_path(house_id) %>
  <% end.join(', ').html_safe %>
</b></p>

<h2>Publications</h2>
<% if @publications.any? %>
  <p>Total published publications: <b><%= @total_count %></b></p>
  <%== @pagy.series_nav(:bootstrap) %>
   <table class="table table-bordered">
      <thead>
        <tr>
          <th scope="col">Title</th>
          <!-- <th scope="col">Status</th> -->
          <th scope="col">Published at</th>
        </tr>
      </thead>
      <tbody>
        <% @publications.each do |publication| %>
          <tr>
            <td><%= link_to publication.title, publication_path(publication.publication_work_id) %></td>
            <!-- <td><%#= publication.status %></td> -->
            <td><%= nice_date_time(publication.published_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
<% else %>
  <h2>No publications</h2>
<% end %>
