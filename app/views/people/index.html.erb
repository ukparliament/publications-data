<p>
  <%#= link_to 'Publications (unpublished)', publications_unpublished_house_path(@house.datagraphs_id) %>
</p>
<% if @people.any? %>
<%== @pagy.series_nav(:bootstrap) %>
<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col" class="col-4">Title</th>
    </tr>
  </thead>
  <tbody>
    <% @people.each do |person| %>
    <tr>
      <th scope="row"> <%= link_to person.name, person_path(person.datagraphs_id) %></th>

    </tr>
    <% end %>
  </tbody>
</table>
<% else %>
<h2>No people</h2>
<% end %>