<p><%#= link_to 'Publications (unpublished)', publications_unpublished_house_path(@house.datagraphs_id) %></p>

<% if @publications.any? %>
  <%== @pagy.series_nav(:bootstrap) %>

  <table class="table table-bordered">
    <thead>
      <tr>
        <th scope="col" class="col-4">Title</th>
        <th scope="col">Created at</th>
        <th scope="col">Status</th>
        <th scope="col">Published at</th>
        <th scope="col">Teaser (extract)</th>
      </tr>
    </thead>
    <tbody>
      <% @publications.limit(100).each do |publication| %>
        <tr>
          <th scope="row">
            <%= title_of_publication_work_but_link_to_expression(
                  publication_expression_datagraphs_id: publication.datagraphs_id,
                  publication_work_datagraphs_id: publication.expression_of,
                  publication_expression_title: publication.display_title
                ) %>
          </th>
          <td><%= publication.display_created_at %></td>
          <td><%= publication.status %></td>
          <td><%= publication.display_published_at %></td>
          <td><%= truncate(publication.teaser_text, length: 20) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <h2>No publications</h2>
<% end %>
