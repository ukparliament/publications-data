
<p><%= @teaser_text %></p>
<p>Reference <b><%= @reference %></b></p>
<p>Published by <b><%= link_to @research_service_name, research_service_path(@research_service_id) %></b></p>

<p>Contributors:</p>
<% @contributors.each do |contributor| %>
  <p><%= link_to "#{contributor['person_name']} (#{contributor['contribution_types'].join(', ')})", person_path(contributor["person_id"]) %></p>
<% end %>

<p>Resources:</p>
<% @resources.each do |resource| %>
  <p>File title: <%= resource["file_title"] %></p>
  <p>File label: <%= resource["file_label"] %></p>
  <p>File type: <%= resource["file_type"] %></p>
  <p>Mime type: <%= resource["mime_type"] %></p>
  <p>File size in bytes: <%= resource["file_size_in_bytes"] %></p>
  <p>Public url: <%= link_to resource["public_url"], resource["public_url"] %></p>
  <p>Private url: <%= link_to resource["private_url"], resource["private_url"] %></p>

  <iframe src="<%= resource["public_url"] %>" width="80%" height="300px" type="application/pdf" title="Embedded PDF">
    <p>Your browser doesn't support PDF preview. <a href="<%= @pdf_url %>">Download it instead.</a></p>
  </iframe>

<% end %>

<h2>Expressions of this publication</h2>

<% if @publication_expressions.any? %>

  <p>Total expressions: <%= @total_count %></p>

  <% if @total_count > @publication_expressions.count %>
    <%== @pagy.series_nav(:bootstrap) %>
  <% end %>

   <table class="table table-bordered">
      <thead>
        <tr>
          <th scope="col" class="col-4">Title</th>
          <th scope="col">Status</th>
          <th scope="col">Ordinality</th>
          <th scope="col">Created at</th>
          <th scope="col">Published at</th>
          <th scope="col">People</th>
        </tr>
      </thead>
      <tbody>
        <% @publication_expressions.each do |publication| %>
          <tr>
            <td><%= publication.title %></td>
            <td><%= publication.status %></td>
            <td><%= publication.ordinality %></td>
            <td><%= nice_date_time(publication.created_at) %></td>
            <td><%= nice_date_time(publication.published_at) %></td>

            <td>
              <% if publication.people.any? %>
                <% publication.people.each do |person_details, role| %>
                  <p><%= person_details_and_role(person_details, role) %></p>
                <% end %>
              <% else %>
                  Contributors are missing for this record
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
<% else %>
  <h2>No publications</h2>
<% end %>
