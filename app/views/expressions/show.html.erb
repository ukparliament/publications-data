<p><i><%= @expression.teaser_text %></i></p>
<p><b>Reference:</b> <%= @expression.ref %></p>
<p><b>Published at:</b> <%= nice_date_time @expression.published_at %></p>
<p><b>Created at:</b> <%= nice_date_time @expression.created_at %></p>
<p><b>Publication work:</b> <%= link_to @expression.title, publication_path(@expression.publication_work_id) %></p>
<p><b>Status:</b> <%= @expression.status %></p>

<h2>Contributors</h2>
<ul>
  <% @contributors.each do |contributor| %>
    <li><%= link_to "#{contributor.person_name} (#{contributor.contribution_types.join(', ')}) - #{contributor.is_public ? 'Public contribution' : 'Private contribution' }", person_path(contributor.person_id) %></li>
  <% end %>
</ul>

<h2>Section contributions</h2>
<ul>
  <% @sections.each do |section| %>
    <li><%= link_to section.name, section_path(section.id) %></li>
  <% end %>
</ul>

<hr>
<h2>Related links</h2>
<% if @related_links.any? %>
  <ul>
  <% @related_links.each do |related_link| %>
    <li><%= link_to related_link.title, related_link.url %></li>
  <% end %>
  </ul>
<% else %>
  <p>We do not have any related links for this expression.</p>
<% end %>

<hr>
<h2>Resources</h2>
<% if @resources.any? %>
  <% @resources.each do |resource| %>
    <% if resource.public_url %>
      <%= link_to resource.public_url, class: "card" do %>
        <div class="card-inner">
          <div class="content">
            <div class="primary-info"><%= resource.file_title %></div>
            <div class="secondary-info">Label: <%= resource.file_label %></div>
            <div class="tertiary-info">Public URL: <%= resource.public_url %></div>
            <div class="tertiary-info">Private URL: <%= resource.private_url %></div>
            <div class="tertiary-info">
              <% if resource.mime_type == "application/pdf" %>
                <details>
                  <summary>Show preview of PDF</summary>
                  <iframe src="<%= resource.public_url %>" width="80%" height="300px" type="application/pdf" title="Embedded PDF">
                    <p>Your browser doesn't support PDF preview. <a href="<%= @pdf_url %>">Download it instead.</a></p>
                  </iframe>
                </details>
              <% end %>
            </div>
          </div>
          <div class="info">
            <div class="info-inner">
              <div class="indicators-left">
                <div class="indicator indicator-label"><%= resource.mime_type %></div>
              </div>
              <div class="indicators-right">
                <div class="indicator">
                  <i class="fas fa-hdd"></i>
                  <%= number_to_human_size resource.file_size_in_bytes %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="card">
        <div class="card-inner">
          <div class="content">
            <div class="primary-info"><%= resource.file_title %></div>
            <div class="secondary-info">Label: <%= resource.file_label %></div>
            <div class="tertiary-info">No public URL</div>
            <div class="tertiary-info">Private URL: <%= resource.private_url %></div>
          </div>

          <div class="info">
            <div class="info-inner">
              <div class="indicators-left">
                <div class="indicator indicator-label"><%= resource.mime_type %></div>
              </div>
              <div class="indicators-right">
                <div class="indicator">
                  <i class="fas fa-hdd"></i>
                  <%= number_to_human_size resource.file_size_in_bytes %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <p>We do not have any file resources linked to this expression.</p>
<% end %>
