<p><i><%= @publication.teaser_text %></i></p>
<p><b>Reference:</b> <%= @publication.ref %></p>
<p><b>Published:</b> <%= nice_date_time @publication.published_at %></p>

<%= form_for(:expressions, method: :get, include_hidden: false) do |f| %>
  <fieldset class="p-form__fieldset">
    <legend class="p-form__fieldset-legend">Status selector</legend>
    <div class="p-form__checkbox-group">
      <% @statuses.each_with_index do |status, index| %>
        <div class="p-form__checkbox-item">
          <input
            type="checkbox"
            name="statuses[]"
            id="checkbox-standard-<%= status %>"
            value="<%= status %>"
            <% if @selected_statuses.include?(status) %>
              checked
            <% end %>
          >
          <label for="checkbox-standard-<%= status %>" class="p-form__checkbox-item-label">
            <%= status %>
          </label>
        </div>
      <% end %>
    </div>
  </fieldset>
  <%= f.submit value: "Filter expressions", class: "btn btn-primary mt-3 mb-3" %>
<% end %>

<h2>Expressions</h2>
<% if @expressions.any? %>

  <p>Total expressions, for statuses - <i><%= @selected_statuses.join(', ') %></i>: <b><%= @total_count %></b></p>

  <% if @total_count > @expressions.count %>
    <%== @pagy.series_nav(:bootstrap) %>
  <% end %>

   <table class="table table-bordered">
      <thead>
        <tr>
          <th scope="col" class="col-4">Title</th>
          <th scope="col">Status</th>
          <th scope="col">Published at</th>
          <th scope="col">Contributions</th>
        </tr>
      </thead>
      <tbody>
        <% @expressions.each do |expression| %>
          <tr>
            <td><%= link_to expression.title, publication_expression_path(expression.publication_work_id, expression.id) %></td>
            <td><%= expression.status %></td>
            <td><%= nice_date_time(expression.published_at) %></td>
            <td>
              <% if expression.contributions.any? %>
                <% expression.contributions.sort_by { |cont| cont[1] || 1}.each do |(((id, name), role), public), _ordinality| %>
                  <p><%= link_to name, person_path(id) %> - as <%= role %> - <%= public ? "Public" : "Private" %> contribution</p>
                <% end %>
              <% else %>
                  Contributions are missing for this record
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
<% else %>
  <h2>No publications</h2>
<% end %>
